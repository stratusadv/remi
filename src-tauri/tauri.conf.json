{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "remi",
    "version": "0.1.5",
    "identifier": "com.stratusadv.remi",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "remi",
                "width": 1280,
                "height": 800,
                "minWidth": 720,
                "minHeight": 540,
                "maximized": true,
                "resizable": true,
                "center": true,
                "visible": false,
                "backgroundColor": "#0b1018",
                "allowLinkPreview": false,
                "generalAutofillEnabled": false
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://api.stripe.com; frame-src https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com; media-src 'self' blob:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' blob: https://js.stripe.com https://*.js.stripe.com; worker-src 'self' blob:",
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$DATA/com.stratusadv.remi/jobs/**"
                ]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "category": "Productivity",
        "copyright": "Copyright (c) 2026 Stratus Advanced Technologies",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "createUpdaterArtifacts": true,
        "linux": {
            "appimage": {
                "bundleMediaFramework": true
            },
            "deb": {
                "conflicts": ["scribe"],
                "replaces": ["scribe"]
            },
            "rpm": {
                "obsoletes": ["scribe"]
            }
        },
        "macOS": {
            "entitlements": "./Entitlements.plist",
            "minimumSystemVersion": "14.0",
            "signingIdentity": "-"
        },
        "windows": {
            "nsis": {
                "installerHooks": "./windows-installer-hooks.nsh"
            }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwNjkwQThFOTBFQjBCNUUKUldSZUMrdVFqZ3Bwa0FrQUhqSWU3YjVUTk5ya1JWU2pyUHhQR0JUb252MDlHdTZkUjBKWlNaMWoK",
            "endpoints": [
                "https://github.com/stratusadv/remi/releases/latest/download/latest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
